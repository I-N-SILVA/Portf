{
  "name": "interactive-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:dead": "node scripts/find-dead-modules.mjs --check",
    "types:gen": "supabase gen types typescript --project-id \"$SUPABASE_PROJECT_ID\" > lib/supabase/types.ts",
    "verify": "npm run typecheck && npm run lint && npm run check:dead && npm run check:types && npm run test && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:types": "node scripts/check-types-drift.mjs --check"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.562.0",
    "next": "^15.1.3",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-confetti": "^6.4.0",
    "react-dom": "^19.0.0",
    "react-use-measure": "^2.1.7",
    "stripe": "^17.5.0",
    "tailwind-merge": "^3.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "playwright-core": "^1.62.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}

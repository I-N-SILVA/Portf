# ── Supabase ─────────────────────────────────────────────────────────────
# Project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Bypasses RLS — never expose to the browser. Used by the
# invite flow, admin actions and (later) Stripe webhooks.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Stripe (Phase 3 — Billing) ───────────────────────────────────────────
# Dashboard → Developers → API keys (use test keys in dev).
STRIPE_SECRET_KEY=sk_test_...
# Dashboard → Developers → Webhooks → your endpoint's signing secret.
# Endpoint URL: https://<any-host>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Engagement & Nudges (Phase 5) ─────────────────────────────────────────
# Resend for transactional email (nudges). Leave unset → in-app only.
RESEND_API_KEY=re_...
EMAIL_FROM="Shaft OS <hello@iamnsilva.me>"
# Where admin-facing nudges (e.g. unconfirmed bookings) are emailed.
ADMIN_NOTIFY_EMAIL=ops@iamnsilva.me
# Protects the hourly cron endpoint; the Netlify scheduled function
# (netlify/functions/nudges-cron.mjs) sends it as a Bearer token.
# Required in production: /api/cron/nudges returns 503 without it.
CRON_SECRET=generate-a-long-random-string

# ── Bookings (Phase 4) ────────────────────────────────────────────────────
# Optional: URL of an external scheduler to embed on the client bookings page
# (your TidyCal page, Cal.com, etc.). Leave unset for the native request flow.
NEXT_PUBLIC_BOOKING_URL=
# TidyCal webhook shared secret. REQUIRED in production — the endpoint writes
# with the service role, so it refuses every request (503) when this is unset.
# Prefer sending it as an `x-tidycal-token` header; the query-string form
# below works too but ends up in access logs.
#   https://<host>/api/tidycal/webhook?token=<this value>
# Matches bookings to clients by contact email and syncs them in.
TIDYCAL_WEBHOOK_SECRET=generate-a-long-random-string

# ── App ──────────────────────────────────────────────────────────────────
# Canonical origin. Everything is path-based on this one host — /studio,
# /c/<client-slug>, /admin — so no subdomains need to exist. Used for
# absolute URLs in emails and metadata, and to redirect the legacy
# portal./admin./clients./work. subdomains if their DNS still resolves.
NEXT_PUBLIC_SITE_URL=https://iamnsilva.me

# ─── Error reporting (optional) ──────────────────────────────────────────
# Anything that accepts a JSON POST: a Sentry ingest proxy, a Slack incoming
# webhook, your own function. Unset → errors stay in the platform logs.
ERROR_WEBHOOK_URL=

# ─── Pitch view analytics (optional) ─────────────────────────────────────
# Signs the visitor cookie and derives the per-network rate-limit tag. Any
# long random string. Unset → falls back to the service role key.
PITCH_VIEW_SECRET=

# ─── Content-Security-Policy (optional, BUILD-TIME) ──────────────────────
# Unset → a strict policy that still allows inline <script>, so the marketing
# pages stay statically prerendered.
# CSP_STRICT=1 → per-request nonces and no 'unsafe-inline'. Strictly better
# security; opts the whole app into dynamic rendering. Must be set at build
# time, not just at runtime. See lib/security/csp.ts.
CSP_STRICT=

# ─── Legacy subdomain redirects (optional) ───────────────────────────────
# portal.* / admin.* / clients.* / work.* are 308'd onto their path
# equivalents. Set to `off` once the DNS records are gone.
LEGACY_SUBDOMAINS=

# ── Supabase ─────────────────────────────────────────────────────────────
# Project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Bypasses RLS — never expose to the browser. Used by the
# invite flow, admin actions and (later) Stripe webhooks.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Stripe (Phase 3 — Billing) ───────────────────────────────────────────
# Dashboard → Developers → API keys (use test keys in dev).
STRIPE_SECRET_KEY=sk_test_...
# Dashboard → Developers → Webhooks → your endpoint's signing secret.
# Endpoint URL: https://<any-host>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Engagement & Nudges (Phase 5) ─────────────────────────────────────────
# Resend for transactional email (nudges). Leave unset → in-app only.
RESEND_API_KEY=re_...
EMAIL_FROM="Shaft OS <hello@iamnsilva.me>"
# Where admin-facing nudges (e.g. unconfirmed bookings) are emailed.
ADMIN_NOTIFY_EMAIL=ops@iamnsilva.me
# Protects the hourly cron endpoint; Vercel Cron sends it as a Bearer token.
CRON_SECRET=generate-a-long-random-string

# ── Bookings (Phase 4) ────────────────────────────────────────────────────
# Optional: URL of an external scheduler to embed on the client bookings page
# (your TidyCal page, Cal.com, etc.). Leave unset for the native request flow.
NEXT_PUBLIC_BOOKING_URL=
# TidyCal webhook shared secret. Point TidyCal at:
#   https://<host>/api/tidycal/webhook?token=<this value>
# Matches bookings to clients by contact email and syncs them in.
TIDYCAL_WEBHOOK_SECRET=generate-a-long-random-string

# ── App ──────────────────────────────────────────────────────────────────
# Root marketing domain (used for absolute URLs / redirects).
NEXT_PUBLIC_SITE_URL=https://iamnsilva.me
